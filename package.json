{
  "name": "sab-win'26",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test:smoke",
    "test:smoke": "npm run build",
    "format": "prettier --write \"**/*.{md,json,jsonc,yml,yaml,js,mjs,cjs,jsx,ts,tsx,css,html}\"",
    "format:check": "prettier --check \"**/*.{md,json,jsonc,yml,yaml,js,mjs,cjs,jsx,ts,tsx,css,html}\"",
    "format:changed": "node ./scripts/lint/format-changed.mjs",
    "format:changed:check": "node ./scripts/lint/format-changed.mjs --check",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:md:changed": "node ./scripts/lint/markdownlint-changed.mjs",
    "lint:md:custom": "node ./scripts/lint/check-markdown.mjs",
    "lint:md-links": "node ./scripts/lint/check-markdown-links.mjs",
    "lint:md-links:changed": "node ./scripts/lint/check-markdown-links.mjs --changed-only",
    "lint:file-names": "node ./scripts/lint/check-file-names.mjs",
    "lint:mermaid": "node scripts/lint/lint-mermaid.mjs",
    "check:branch": "node ./scripts/git/check-branch-name.mjs",
    "check:plans": "node ./scripts/plans/validate-plans.mjs --all",
    "check:plans:staged": "node ./scripts/plans/validate-plans.mjs --staged",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "prepare": "husky",
    "build:css": "sass ui/scss/wireframe.scss ui/wireframe.css --no-source-map",
    "build:templates": "node ./scripts/build/build-templates.mjs",
    "build": "npm run build:css && npm run build:templates",
    "ci:check": "npm run lint:md && npm run lint:md:custom && npm run lint:md-links && npm run lint:file-names && npm run check:plans && npm run build && npm run lint:mermaid",
    "ci:check:changed": "npm run format:changed:check && npm run lint:md:changed && node ./scripts/lint/check-markdown.mjs --changed-only && node ./scripts/lint/check-file-names.mjs --changed-only && npm run lint:md-links:changed && npm run check:plans && npm run lint:mermaid",
    "commit": "npm run format:changed && npm run ci:check:changed && npm run commit:atomic",
    "commit:quiet": "npm run --silent format:changed >/dev/null && npm run --silent ci:check:changed >/dev/null && npm run --silent commit:atomic",
    "commit:all": "npm run format && npm run ci:check && npm run commit:atomic",
    "commit:atomic": "node ./scripts/git/atomic-commit.mjs",
    "commit:atomic:yes": "node ./scripts/git/atomic-commit.mjs --yes",
    "commit:atomic:dry-run": "node ./scripts/git/atomic-commit.mjs --dry-run",
    "commit:atomic:staged": "node ./scripts/git/atomic-commit.mjs --staged-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CeJIDb/sab-win-26-parking.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CeJIDb/sab-win-26-parking/issues"
  },
  "homepage": "https://github.com/CeJIDb/sab-win-26-parking#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.22.1",
    "nunjucks": "^3.2.4",
    "prettier": "^3.8.3",
    "puppeteer": "^23.11.1",
    "sass": "^1.77.0"
  }
}
