{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "name": "Block secret file writes",
            "displayName": "Block secret file writes",
            "title": "Block secret file writes",
            "description": "Block writes to env files, keys, sqlite databases, and secret-like paths.",
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/block-secret-write.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "name": "Block unsafe git add",
            "displayName": "Block unsafe git add",
            "title": "Block unsafe git add",
            "description": "Block git add -A, git add --all, and git add .",
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/block-unsafe-git-add.mjs\""
          },
          {
            "name": "Block push to main",
            "displayName": "Block push to main",
            "title": "Block push to main",
            "description": "Block direct git push to main or master.",
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/block-push-to-main.mjs\""
          },
          {
            "name": "Validate staged plans",
            "displayName": "Validate staged plans",
            "title": "Validate staged plans",
            "description": "Validate staged plans before git commit.",
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/validate-staged-plans.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "name": "Remind graph navigation",
            "displayName": "Remind graph navigation",
            "title": "Remind graph navigation",
            "description": "Remind the agent to read the graph report before raw searches.",
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/remind-graph-navigation.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "name": "Validate plan on write",
            "displayName": "Validate plan on write",
            "title": "Validate plan on write",
            "description": "Validate plans/YYYY-MM-DD-*.md after file writes.",
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/validate-plan-on-write.mjs\""
          },
          {
            "name": "Format changed file",
            "displayName": "Format changed file",
            "title": "Format changed file",
            "description": "Run Prettier after supported file writes.",
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/format-on-write.mjs\"",
            "statusMessage": "\u0424\u043e\u0440\u043c\u0430\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435..."
          },
          {
            "name": "Update graph after write",
            "displayName": "Update graph after write",
            "title": "Update graph after write",
            "description": "Refresh the local graph after file writes.",
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/update-graph-on-write.mjs\"",
            "statusMessage": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0433\u0440\u0430\u0444\u0430..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "name": "Remind atomic commit",
            "displayName": "Remind atomic commit",
            "title": "Remind atomic commit",
            "description": "Remind about npm run commit:atomic when worktree diff is large.",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/remind-atomic-commit.sh\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "name": "Play permission sound",
            "displayName": "Play permission sound",
            "title": "Play permission sound",
            "description": "Play a sound when permission is requested.",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/play-sound.sh\" notify"
          }
        ]
      }
    ]
  }
}
