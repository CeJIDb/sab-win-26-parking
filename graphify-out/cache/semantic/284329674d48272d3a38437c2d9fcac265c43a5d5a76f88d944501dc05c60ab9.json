    {
      "id": "demo_5_modular_monolith",
      "label": "\u041c\u043e\u0434\u0443\u043b\u044c\u043d\u044b\u0439 \u043c\u043e\u043d\u043e\u043b\u0438\u0442 \u2014 \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u043d\u044b\u0439 \u0432\u044b\u0431\u043e\u0440",
      "file_type": "rationale",
      "source_file": "docs/demo-days/demo-5/demo-5-script.md",
      "source_location": "\u0421\u043b\u0430\u0439\u0434 29",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": "cejidb",
      "rationale": "\u0412\u044b\u0431\u0440\u0430\u043d \u043c\u043e\u0434\u0443\u043b\u044c\u043d\u044b\u0439 \u043c\u043e\u043d\u043e\u043b\u0438\u0442 \u0432\u043c\u0435\u0441\u0442\u043e \u043c\u0438\u043a\u0440\u043e\u0441\u0435\u0440\u0432\u0438\u0441\u043e\u0432 \u0438\u0437-\u0437\u0430 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438 3-4 RPS, \u0431\u044e\u0434\u0436\u0435\u0442\u0430 10-15 \u043c\u043b\u043d \u0440\u0443\u0431., \u0441\u0440\u043e\u043a\u043e\u0432 4-6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f DevOps \u0432 \u0448\u0442\u0430\u0442\u0435 \u0438 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0439 152-\u0424\u0417 \u043f\u043e \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044e \u041f\u0414\u043d \u0432 \u0435\u0434\u0438\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440\u0435. DDD-\u0434\u0435\u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0446\u0438\u044f \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u043e\u0437\u0434\u043d\u0435\u0435 \u0432\u044b\u0434\u0435\u043b\u0438\u0442\u044c \u043c\u043e\u0434\u0443\u043b\u0438 \u0432 \u0441\u0435\u0440\u0432\u0438\u0441\u044b \u043f\u0440\u0438 \u0440\u043e\u0441\u0442\u0435 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438."
    },
    {
      "id": "demo_5_outbox_pattern",
      "label": "Outbox-\u043f\u0430\u0442\u0442\u0435\u0440\u043d \u0434\u043b\u044f \u0430\u0441\u0438\u043d\u0445\u0440\u043e\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440",
      "file_type": "rationale",
