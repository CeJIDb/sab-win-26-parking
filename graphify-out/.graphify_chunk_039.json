  "nodes": [
    {
      "id": "assets_demo_day_1_slide_01_title_five_whys",
      "label": "Demo Day 1 — Title Slide: Автоматизация частного паркинга. Five Whys: от проблем к решению. Этап: Исследование и анализ. Докладчики: Александр (ведущий, UML Class Diagram), Артем (Event Storming), Павел (BPMN), Денис (UML StateChart), Марина (Canvas, Problem Statement).",
      "file_type": "image",
      "source_file": "docs/demo-days/demo-1/slides/01.jpg",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": "Александр Друзякин",
      "contributor": null
    },
    {
      "id": "assets_demo_day_1_slide_02_context_current_situation",
      "label": "Demo Day 1 — Контекст и текущая ситуация. Объект: Санкт-Петербург, частный открытый паркинг, 600 машиномест (50 ОВЗ), режим 24/7. Текущие проблемы: учет — ручной ввод в Excel, оборудование — шлагбаум без интеграции, доступ — физические карты, оплата — наличные/терминал.",
      "file_type": "image",
      "source_file": "docs/demo-days/demo-1/slides/02.jpg",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": "Александр Друзякин",
      "contributor": null
    },
    {
      "id": "assets_demo_day_1_slide_03_research_results",
      "label": "Demo Day 1 — Результаты исследования. Источник: 3 интервью с владельцем паркинга (Елена Гриценко). Выявленные проблемы: 30% мест простаивает (потеря дохода), 80% времени охранников на непрофильной рутине, 0% возможности удобного использования услугами клиентами, ручные операции во всех процессах.",
      "file_type": "image",
      "source_file": "docs/demo-days/demo-1/slides/03.jpg",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": "Александр Друзякин",
      "contributor": null
    },
    {
      "id": "assets_demo_day_1_slide_04_event_storming_as_is",
      "label": "Demo Day 1 — Event Storming AS-IS (Визуализация хаоса). Процесс предоставления парковочного места: цепочка оффлайн-событий на КПП, все операции выполняются вручную сотрудниками, ключевые решения принимаются сотрудниками, а не системой. Фотография стикеров Event Storming на доске.",
      "file_type": "image",
      "source_file": "docs/demo-days/demo-1/slides/04.jpg",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": "Артем Субботин",
      "contributor": null
    },
    {
      "id": "assets_demo_day_1_slide_05_bpmn_modeling",
      "label": "Demo Day 1 — Моделирование бизнес-процессов (BPMN). Показана базовая схема BPMN: Pool, Event (старт), Task, Gateway (ветвление Yes/No), Event (конец). Докладчик: Павел Борунов.",
      "file_type": "image",
      "source_file": "docs/demo-days/demo-1/slides/05.jpg",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": "Павел Борунов",
      "contributor": null
    },
    {
      "id": "assets_demo_day_1_slide_06_bpmn_big_picture",
      "label": "Demo Day 1 — BPMN Big Picture. Слайд-переход (заглушка) с заголовком 'BPMN - Big Picture'. Докладчик: Павел Борунов.",
      "file_type": "image",
      "source_file": "docs/demo-days/demo-1/slides/06.jpg",
